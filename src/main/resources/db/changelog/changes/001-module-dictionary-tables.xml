<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-dictionary-category-table" author="inmaytide" objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
        <createTable tableName="dictionary_category" remarks="字典分类表">
            <column name="id" type="varchar(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="parent_id" type="varchar(32)" remarks="父级分类ID"/>
            <column name="code" type="varchar(64)" remarks="字典分类编码">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(64)" remarks="分类名称">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="varchar(256)" remarks="描述"/>
            <column name="display_order" type="int" defaultValueNumeric="0" remarks="排序号"/>
            <column name="status" type="int" defaultValueNumeric="1" remarks="状态：0=禁用，1=启用"/>
            <column name="path" type="varchar(512)" remarks="物化路径"/>
            <column name="max_allowed_level" type="int" remarks="字典允许最大层级,-1标识不限制" defaultValue="-1"/>
            <!-- 审计字段 -->
            <column name="created_by" type="varchar(32)" remarks="创建人"/>
            <column name="created_at" type="timestamp" defaultValueDate="now()" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(32)" remarks="更新人"/>
            <column name="updated_at" type="timestamp" defaultValueDate="now()" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="int" defaultValueNumeric="0" remarks="乐观锁版本">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="int" defaultValueNumeric="0" remarks="逻辑删除：0=未删除，1=已删除">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>
            INSERT INTO `core`.`dictionary_category` (`id`, `parent_id`, `code`, `name`, `description`, `display_order`, `status`, `path`, `max_allowed_level`, `created_by`, `created_at`, `updated_by`, `updated_at`, `version`, `deleted`)
                VALUES ('019a8f42c7b071a2a5d3e9c4816f0b23', NULL, 'GENDER', '性别', NULL, 0, 1, NULL, 1, '9999', '2026-11-01 00:00:00', '9999', '2026-11-01 00:00:00', 0, 0);
        </sql>
    </changeSet>

    <changeSet id="002-create-dictionary-item-table" author="inmaytide" objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
        <createTable tableName="dictionary_item" remarks="字典分类表">
            <column name="id" type="varchar(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- 审计字段 -->
            <column name="created_by" type="varchar(32)" remarks="创建人"/>
            <column name="created_at" type="timestamp" defaultValueDate="now()" remarks="创建时间">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="varchar(32)" remarks="更新人"/>
            <column name="updated_at" type="timestamp" defaultValueDate="now()" remarks="更新时间">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="int" defaultValueNumeric="0" remarks="乐观锁版本">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="int" defaultValueNumeric="0" remarks="逻辑删除：0=未删除，1=已删除">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>


</databaseChangeLog>
