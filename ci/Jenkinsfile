pipeline {
    agent any

    tools {
        jdk 'jdk-27.0.1.0.3'
        maven 'apache-maven-3.10.0'
    }

    parameters {
        string(
            name: 'VERSION',
            defaultValue: '3.0.0',
            description: 'Version'
        )
    }

    options {
        disableConcurrentBuilds()
    }

    environment {
        SERVICE_NAME    = 'core'
    }

    stages {
        stage('Build Maven Project') {
            steps {
                script {
                    echo "JAVA_HOME=$JAVA_HOME"
                    sh 'mvn clean package -Dmaven.test.skip=true -Porbit'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh """
                        docker build \
                            --platform linux/amd64 \
                            -f ci/Dockerfile \
                            -t orbit/${env.SERVICE_NAME}:${params.VERSION} \
                            .
                    """
                }
            }
        }

        stage('Push Harbor') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'harbor-credentials',
                        usernameVariable: 'HARBOR_USER',
                        passwordVariable: 'HARBOR_PASSWORD'
                    )
                ]) {
                    sh '''#!/bin/bash
                        set -e

                        echo "========== Harbor Configuration =========="
                        echo "Harbor: $HARBOR"
                        echo "Harbor User: $HARBOR_USER"
                        echo "Image: orbit/$SERVICE_NAME:$VERSION"

                        echo "========== Login Harbor =========="
                        echo "$HARBOR_PASSWORD" | docker login "$HARBOR" \
                            -u "$HARBOR_USER" \
                            --password-stdin

                        echo "========== Tag Image =========="
                        docker tag \
                            "orbit/$SERVICE_NAME:$VERSION" \
                            "$HARBOR/orbit/$SERVICE_NAME:$VERSION"

                        docker tag \
                            "orbit/$SERVICE_NAME:$VERSION" \
                            "$HARBOR/orbit/$SERVICE_NAME:latest"

                        echo "========== Push Image =========="
                        docker push "$HARBOR/orbit/$SERVICE_NAME:$VERSION"
                        docker push "$HARBOR/orbit/$SERVICE_NAME:latest"

                        echo "========== Logout Harbor =========="
                        docker logout "$HARBOR"

                        echo "Harbor push completed!"
                    '''
                }
            }
        }

        stage('Deploy Kubernetes') {
            steps {
                script {
                    sh '''#!/bin/bash
                        set -euo pipefail
                       IMAGE="$HARBOR/orbit/$SERVICE_NAME:$VERSION"

                       echo "========== Deployment Configuration =========="
                       echo "Service: $SERVICE_NAME"
                       echo "Version: $VERSION"
                       echo "Image: $IMAGE"

                       if [ -z "$VERSION" ]; then
                           echo "ERROR: VERSION cannot be empty"
                           exit 1
                       fi
                       echo "========== Update Image Version =========="
                       cd ci/k8s
                       kustomize edit set image \
                           "$HARBOR/orbit/$SERVICE_NAME=$IMAGE"
                       echo "========== Preview Kubernetes Resources =========="
                       kubectl kustomize .
                       echo "========== Deploy Kubernetes =========="
                       kubectl apply -k .
                       echo "========== Rollout Status =========="
                       kubectl rollout status \
                           deployment/$SERVICE_NAME \
                           -n orbit \
                           --timeout=300s
                       echo "========== Deployment Result =========="
                       kubectl get pods -n orbit -o wide
                       echo "========== Current Image =========="
                       kubectl get deployment "$SERVICE_NAME" \
                           -n orbit \
                           -o jsonpath='{.spec.template.spec.containers[0].image}'
                    '''
                }
            }
        }

    }

}
